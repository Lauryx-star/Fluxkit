# Copy this file to .env and replace every CHANGE_ME value before starting Compose.
# Keep .env private; it contains database, signing, and administrator credentials.
# Use URL-safe random values (letters, numbers, hyphens, underscores) for passwords.

# PostgreSQL role used only by the FluxKit server.
POSTGRES_PASSWORD=CHANGE_ME_generate_a_long_random_password

# Unique random signing key, at least 32 bytes. Changing it invalidates existing sessions.
FLUXKIT_SIGNING_KEY=CHANGE_ME_generate_at_least_32_random_bytes

# Initial server administrator. Bootstrap credentials are only used when this account
# does not exist yet; changing them later does not reset an existing account password.
FLUXKIT_ADMIN_USERNAME=CHANGE_ME_admin_username
FLUXKIT_ADMIN_PASSWORD=CHANGE_ME_generate_a_strong_admin_password

# Host port bound to loopback by default. Put a TLS reverse proxy in front for remote access.
FLUXKIT_PORT=8080
