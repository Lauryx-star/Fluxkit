    "allow-server-prepare-transfer",
    "allow-server-commit-transfer",
    "allow-server-discard-transfer",
    "allow-server-project-members",
    "allow-server-add-project-member",
    "allow-server-update-project-member",
    "allow-server-remove-project-member",
    "allow-server-account",
    "allow-server-admin-users",
    "allow-server-admin-approve-user",
    "allow-server-admin-set-user-status",
    "allow-server-admin-delete-user",
    "allow-server-create-team-project"
