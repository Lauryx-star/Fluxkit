{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Project-scoped native operations for the bundled main window.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-preview-openapi-export",
    "allow-save-openapi-export",
    "allow-discard-openapi-export",
    "allow-choose-openapi-import",
    "allow-rename-import-variable",
    "allow-choose-postman-import",
    "allow-commit-openapi-import",
    "allow-discard-openapi-import",
    "allow-choose-project",
    "allow-restore-last-project",
    "allow-remember-project",
    "allow-reload-project",
    "allow-rename-project",
    "allow-save-project-auth",
    "allow-save-collection",
    "allow-move-request",
    "allow-remove-collection",
    "allow-choose-attachment",
    "allow-close-project",
    "allow-environment-action",
    "allow-begin-http-request",
    "allow-execute-http-request",
    "allow-preview-http-headers",
    "allow-test-authentication",
    "allow-cancel-http-request",
